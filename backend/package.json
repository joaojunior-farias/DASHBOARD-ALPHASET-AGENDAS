{
  "name": "agenda-alpha-set-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch dist/index.js",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:local": "node --env-file-if-exists=.env scripts/postgres-local.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "drizzle-orm": "0.45.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.0",
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "5.9.3"
  }
}
